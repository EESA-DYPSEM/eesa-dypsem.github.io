rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentCommittee() {
      return get(/databases/$(database)/documents/committee/current).data;
    }

    function committeeMember() {
      return signedIn()
        && currentCommittee().members.get(request.auth.uid, null) != null;
    }

    function hasPermission(permission) {
      return committeeMember()
        && currentCommittee().members
            .get(request.auth.uid, {})
            .get('permissions', [])
            .hasAny([permission]);
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            in ['admin', 'superAdmin'];
    }

    function can(permission) {
      return isAdmin() || hasPermission(permission);
    }

    function publishedOrSignedIn() {
      return resource.data.status == 'published' || signedIn();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || can('manage_committee'));
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.prn is string
                    && request.resource.data.department is string
                    && request.resource.data.semester is string;
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Username lookup used only to resolve a login name to the Firebase Auth email.
    // It contains no password or profile data.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username
                    && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      allow delete: if signedIn() && (request.auth.uid == resource.data.uid || isAdmin());
    }

    match /committee/{docId} {
      allow read: if signedIn();
      allow write: if can('manage_committee');
    }

    match /events/{id} {
      allow read: if publishedOrSignedIn();
      allow create: if can('manage_events');
      allow update, delete: if can('manage_events');
    }

    match /projects/{id} {
      allow read: if publishedOrSignedIn();
      allow create: if can('manage_projects');
      allow update, delete: if can('manage_projects');
    }

    match /notices/{id} {
      allow read: if publishedOrSignedIn();
      allow create: if can('manage_notices');
      allow update, delete: if can('manage_notices');
    }

    match /projectSubmissions/{id} {
      allow read: if can('manage_projects') || (signedIn() && request.auth.uid == resource.data.submittedBy);
      allow create: if signedIn()
                    && request.auth.uid == request.resource.data.submittedBy
                    && request.resource.data.status == 'pending';
      allow update: if can('manage_projects') || (signedIn() && request.auth.uid == resource.data.submittedBy);
      allow delete: if can('manage_projects') || (signedIn() && request.auth.uid == resource.data.submittedBy);
    }

    match /projectApplications/{id} {
      allow read: if signedIn()
                  && (request.auth.uid == resource.data.applicantId
                      || can('manage_projects'));
      allow create: if signedIn()
                    && request.auth.uid == request.resource.data.applicantId;
      allow update: if signedIn()
                    && (request.auth.uid == resource.data.applicantId
                        || can('manage_projects'));
      allow delete: if can('manage_projects');
    }

    match /eventRegistrations/{id} {
      allow read: if signedIn()
                  && (request.auth.uid == resource.data.userId
                      || can('manage_events'));
      allow create: if signedIn()
                    && request.auth.uid == request.resource.data.userId;
      allow update: if signedIn()
                    && (request.auth.uid == resource.data.userId
                        || can('manage_events'));
      allow delete: if signedIn()
                    && (request.auth.uid == resource.data.userId
                        || can('manage_events'));
    }

    match /notifications/{id} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow update: if signedIn() && request.auth.uid == resource.data.userId;
      allow create, delete: if can('manage_notifications');
    }

    match /achievements/{id} {
      allow read: if resource.data.status == 'published' || signedIn();
      allow create, update, delete: if can('manage_content');
    }

    match /gallery/{id} {
      allow read: if resource.data.status == 'published' || signedIn();
      allow create, update, delete: if can('manage_content');
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if can('manage_settings');
    }

    // Public, sanitized committee data used by the guest homepage.
    // Private permissions and committee configuration remain in /committee/current.
    match /publicCommittee/{id} {
      allow read: if true;
      allow write: if can('manage_committee');
    }

    // Public aggregate stats; no individual student records are exposed here.
    match /publicStats/{id} {
      allow read: if true;
      allow write: if can('manage_committee');
    }

    match /quizEvents/{id} {
      allow read: if resource.data.status == 'published' || signedIn();
      allow create, update, delete: if can('manage_quizzes');
    }
  }
}
