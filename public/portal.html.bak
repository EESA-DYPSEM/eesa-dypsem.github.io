<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#07101f"><title>EESA • Student Portal</title>
  <link rel="stylesheet" href="./css/app.css">
  <link rel="icon" href="./assets/favicon.ico">
  <link rel="manifest" href="./manifest.webmanifest">
</head>
<body>
<header class="site-header"><a class="brand" href="./index.html"><span class="brand-mark">E</span><span><b>EESA</b><small>Student Portal</small></span></a><a class="text-link" href="./index.html">← Public site</a></header>
<main class="portal-shell">
  <section id="auth-card" class="auth-card">
    <div class="eyebrow">Member access</div><h1>Your EESA space.</h1><p>Sign in to see applications, registrations, projects and member-only notices.</p>
    <label>Email<input id="email" type="email" autocomplete="email"></label>
    <label>Password<input id="password" type="password" autocomplete="current-password"></label>
    <div class="actions"><button id="login" class="btn primary">Sign in</button><button id="signup" class="btn ghost">Create student account</button></div>
    <p id="auth-message" class="form-message"></p>
  </section>

  <section id="portal-app" class="hidden">
    <div class="portal-top"><div><div class="eyebrow">Student dashboard</div><h1 id="welcome">Welcome</h1><p id="role-line"></p></div><button id="logout" class="btn ghost">Sign out</button></div>
    <div class="portal-grid">
      <article class="dash-card"><span class="icon">◷</span><strong id="dash-events">—</strong><span>Upcoming events</span></article>
      <article class="dash-card"><span class="icon">◇</span><strong id="dash-projects">—</strong><span>Projects</span></article>
      <article class="dash-card"><span class="icon">!</span><strong id="dash-notices">—</strong><span>Unread notices</span></article>
    </div>
    <div class="portal-panels">
      <section id="events" class="panel"><div class="section-head"><div><div class="eyebrow">Discover</div><h2>Events</h2></div></div><div id="portal-events" class="stack"></div></section>
      <section id="projects" class="panel"><div class="section-head"><div><div class="eyebrow">Build with others</div><h2>Projects</h2></div></div><div id="portal-projects" class="stack"></div></section>
      <section id="notices" class="panel"><div class="section-head"><div><div class="eyebrow">Updates</div><h2>Notices</h2></div></div><div id="portal-notices" class="stack"></div></section>
    </div>
    <div id="committee-entry" class="hidden committee-entry"><div><div class="eyebrow">Committee</div><h2>Control room</h2><p>Create and publish EESA content from a phone-friendly dashboard.</p></div><a class="btn primary" href="./admin.html">Open Control Room</a></div>
  </section>
</main>
<nav class="mobile-nav"><a href="./index.html">⌂<span>Home</span></a><a href="#events">◷<span>Events</span></a><a href="#projects">◇<span>Projects</span></a><a href="#notices">!<span>Notices</span></a><a href="./portal.html">○<span>Portal</span></a></nav>
<script type="module" src="./js/portal.js"></script>
</body>
</html>