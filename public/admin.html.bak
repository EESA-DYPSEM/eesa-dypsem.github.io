<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07101f"><title>EESA • Control Room</title><link rel="stylesheet" href="./css/app.css">
  <link rel="icon" href="./assets/favicon.ico">
  <link rel="manifest" href="./manifest.webmanifest">
</head>
<body>
<header class="site-header"><a class="brand" href="./portal.html"><span class="brand-mark">E</span><span><b>EESA</b><small>Committee Control Room</small></span></a><a class="text-link" href="./portal.html">← Portal</a></header>
<main class="admin-shell">
  <section class="portal-top"><div><div class="eyebrow">Committee control room</div><h1>Run EESA from one place.</h1><p>Create content without touching Firestore directly.</p></div></section>
  <div id="admin-denied" class="auth-card hidden"><h2>Access restricted</h2><p>Your account does not have committee/admin permissions.</p></div>
  <section id="admin-app" class="hidden">
    <div class="admin-stats" id="admin-stats"></div>
    <div class="quick-actions">
      <button data-open-form="event" class="btn primary">＋ New event</button>
      <button data-open-form="project" class="btn ghost">＋ New project</button>
      <button data-open-form="notice" class="btn ghost">＋ New notice</button>
    </div>
    <section class="panel committee-panel"><div class="section-head"><div><div class="eyebrow">People & permissions</div><h2>Current committee</h2></div><button id="save-committee" class="btn primary">Save committee</button></div><p class="muted-note">Assign positions to registered student accounts. Permissions are attached to positions, not manually typed into individual user roles.</p><div id="committee-fields" class="committee-fields"></div></section>
    <div class="admin-grid">
      <section class="panel"><div class="section-head"><div><div class="eyebrow">Content</div><h2>Recent events</h2></div></div><div id="admin-events" class="stack"></div></section>
      <section class="panel"><div class="section-head"><div><div class="eyebrow">Content</div><h2>Recent projects</h2></div></div><div id="admin-projects" class="stack"></div></section>
      <section class="panel"><div class="section-head"><div><div class="eyebrow">Communication</div><h2>Recent notices</h2></div></div><div id="admin-notices" class="stack"></div></section>
    </div>
  </section>
</main>

<dialog id="content-dialog" class="modal"><form method="dialog" id="content-form"><div class="modal-head"><div><div class="eyebrow" id="form-eyebrow">Create</div><h2 id="form-title">New item</h2></div><button class="icon-btn" value="cancel" aria-label="Close">×</button></div>
  <div id="form-fields"></div><div class="modal-actions"><button class="btn ghost" value="cancel">Cancel</button><button id="save-content" class="btn primary" value="default">Save</button></div>
</form></dialog>
<div id="toast" class="toast"></div>
<script type="module" src="./js/admin.js"></script>
</body>
</html>