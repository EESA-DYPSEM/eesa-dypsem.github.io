<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#07101f">
  <meta name="description" content="EESA — Electrical Engineering Students Association, D.Y. Patil School of Engineering & Management.">
  <title>EESA | Electrical Engineering Students Association</title>

  <style>
    :root{
      color-scheme:dark;
      --bg:#07101f;
      --surface:#0b172a;
      --surface-2:#0e1d33;
      --line:rgba(255,255,255,.09);
      --text:#f5f7fb;
      --muted:#91a0b6;
      --gold:#f5a623;
      --gold-2:#ffc45b;
      --blue:#62b6ff;
      --success:#41d392;
      --danger:#ff6b7a;
      --radius:18px;
      --header:64px;
      --max:1160px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      background:
        radial-gradient(900px 500px at 80% -10%,rgba(245,166,35,.10),transparent 60%),
        radial-gradient(700px 500px at 0% 20%,rgba(98,182,255,.07),transparent 65%),
        var(--bg);
      color:var(--text);
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      line-height:1.5;
      -webkit-font-smoothing:antialiased;
    }
    a{color:inherit;text-decoration:none}
    button,input{font:inherit}
    button{cursor:pointer}
    img{max-width:100%;display:block}
    .container{width:min(calc(100% - 32px),var(--max));margin:auto}

    /* Header */
    .site-header{
      position:fixed;inset:0 0 auto;z-index:50;
      height:var(--header);
      background:rgba(7,16,31,.82);
      border-bottom:1px solid var(--line);
      backdrop-filter:blur(16px);
      -webkit-backdrop-filter:blur(16px);
    }
    .header-inner{height:100%;display:flex;align-items:center;justify-content:space-between}
    .brand{display:flex;align-items:center;gap:10px;min-width:0}
    .brand-mark{
      width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
      background:linear-gradient(145deg,var(--gold-2),var(--gold));
      color:#101827;font-weight:900;font-size:15px;
      box-shadow:0 8px 26px rgba(245,166,35,.16);
      flex:0 0 auto;
    }
    .brand-name{font-weight:900;letter-spacing:-.03em;font-size:17px}
    .brand-sub{display:block;color:var(--muted);font-size:8px;letter-spacing:.13em;text-transform:uppercase}
    .desktop-nav{display:none}
    .header-actions{display:flex;align-items:center;gap:8px}
    .login-btn,.menu-btn{
      border:1px solid var(--line);background:var(--surface);color:var(--text);
      min-height:40px;border-radius:12px;padding:0 13px;font-weight:750;font-size:13px;
    }
    .login-btn{background:var(--gold);border-color:transparent;color:#101827}
    .menu-btn{display:grid;place-items:center;width:42px;padding:0}

    /* Mobile menu */
    .mobile-menu{
      display:none;position:fixed;z-index:49;top:var(--header);left:0;right:0;
      padding:10px 16px 16px;background:rgba(7,16,31,.97);
      border-bottom:1px solid var(--line);box-shadow:0 18px 40px rgba(0,0,0,.3)
    }
    .mobile-menu.open{display:block}
    .mobile-menu a{display:block;padding:14px 12px;border-radius:12px;color:#dbe3ef}
    .mobile-menu a:active{background:var(--surface)}

    /* Hero */
    main{padding-top:var(--header)}
    .hero{padding:72px 0 48px}
    .eyebrow{
      display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border-radius:999px;
      background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.20);
      color:var(--gold-2);font-size:10px;font-weight:800;letter-spacing:.11em;text-transform:uppercase
    }
    .eyebrow-dot{width:6px;height:6px;border-radius:50%;background:var(--gold)}
    h1{
      font-size:clamp(2.5rem,11vw,5.2rem);line-height:.98;letter-spacing:-.055em;
      margin:20px 0 18px;max-width:850px
    }
    .gradient-text{
      background:linear-gradient(105deg,var(--gold-2),var(--gold),#8ecbff);
      -webkit-background-clip:text;background-clip:text;color:transparent
    }
    .hero-copy{max-width:680px;color:var(--muted);font-size:16px}
    .hero-actions{display:flex;flex-direction:column;gap:10px;margin-top:26px}
    .btn{
      min-height:50px;border-radius:14px;border:1px solid var(--line);padding:0 18px;
      display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;
      transition:transform .18s ease,border-color .18s ease,background .18s ease
    }
    .btn-primary{background:var(--gold);color:#101827;border-color:transparent}
    .btn-secondary{background:var(--surface);color:#e9eef7}
    .btn:active{transform:scale(.98)}
    .hero-strip{
      margin-top:42px;padding:16px;border:1px solid var(--line);background:rgba(11,23,42,.62);
      border-radius:var(--radius);display:grid;grid-template-columns:1fr 1fr;gap:14px
    }
    .stat strong{display:block;font-size:20px;letter-spacing:-.03em}
    .stat span{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}

    /* Sections */
    section{padding:64px 0}
    .section-head{margin-bottom:24px}
    .section-kicker{color:var(--gold-2);font-size:10px;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
    .section-title{font-size:28px;line-height:1.08;letter-spacing:-.04em;margin:7px 0}
    .section-copy{color:var(--muted);font-size:14px;max-width:680px}
    .grid{display:grid;gap:12px}
    .card{
      background:linear-gradient(180deg,rgba(14,29,51,.88),rgba(11,23,42,.88));
      border:1px solid var(--line);border-radius:var(--radius);padding:18px
    }
    .card h3{font-size:16px;margin:0 0 6px}
    .card p{margin:0;color:var(--muted);font-size:13px}
    .tag{
      display:inline-flex;padding:5px 8px;border-radius:8px;margin-top:14px;
      background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.15);
      color:var(--gold-2);font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em
    }

    /* Events */
    .event-card{display:flex;flex-direction:column;gap:16px}
    .event-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
    .event-date{color:var(--gold-2);font-size:10px;font-weight:850;text-transform:uppercase}
    .event-status{font-size:9px;padding:5px 7px;border-radius:7px;background:rgba(65,211,146,.08);color:var(--success)}
    .event-footer{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-top:12px;border-top:1px solid var(--line)}
    .event-footer span{font-size:11px;color:var(--muted)}

    /* Public committee preview */
    .people{grid-template-columns:repeat(2,1fr)}
    .person{text-align:center;padding:16px}
    .avatar{width:58px;height:58px;border-radius:50%;margin:0 auto 10px;display:grid;place-items:center;background:var(--surface-2);border:1px solid var(--line);color:var(--gold-2);font-weight:900}
    .person strong{display:block;font-size:13px}
    .person span{font-size:10px;color:var(--muted)}

    /* Portal */
    .portal-wrap{background:linear-gradient(180deg,rgba(11,23,42,.45),rgba(11,23,42,.1));border-block:1px solid var(--line)}
    .auth-card{max-width:500px;margin:auto}
    .field{display:grid;gap:6px;margin-bottom:12px}
    .field label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
    .field input{
      width:100%;height:48px;border-radius:12px;border:1px solid var(--line);
      background:#07101f;color:var(--text);padding:0 13px;outline:none
    }
    .field input:focus{border-color:rgba(245,166,35,.65)}
    .auth-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
    .status{min-height:20px;margin-top:12px;font-size:12px;color:var(--muted)}
    .dashboard{display:none}
    .dashboard.active{display:block}
    .login-view.hidden{display:none}
    .dash-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding-bottom:16px;border-bottom:1px solid var(--line)}
    .dash-email{font-weight:850;font-size:15px;word-break:break-all}
    .role{
      flex:0 0 auto;padding:6px 8px;border-radius:8px;background:rgba(245,166,35,.08);
      border:1px solid rgba(245,166,35,.16);color:var(--gold-2);font-size:9px;font-weight:900;text-transform:uppercase
    }
    .dash-grid{display:grid;gap:10px;margin-top:14px}
    .dash-item{padding:14px;border:1px solid var(--line);border-radius:14px;background:rgba(7,16,31,.6)}
    .dash-item strong{font-size:13px}
    .dash-item p{margin:3px 0 0;color:var(--muted);font-size:11px}

    /* Footer */
    footer{padding:40px 0 calc(88px + env(safe-area-inset-bottom));border-top:1px solid var(--line);color:var(--muted);font-size:12px}
    .footer-grid{display:grid;gap:24px}
    footer h3{font-size:13px;color:var(--text);margin:0 0 8px}
    footer p{margin:0;line-height:1.7}

    /* Bottom navigation: mobile-first */
    .bottom-nav{
      position:fixed;z-index:60;left:0;right:0;bottom:0;
      padding:8px 10px calc(8px + env(safe-area-inset-bottom));
      background:rgba(7,16,31,.94);border-top:1px solid var(--line);
      backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
      display:grid;grid-template-columns:repeat(4,1fr)
    }
    .bottom-nav a{display:grid;place-items:center;gap:2px;padding:5px 2px;color:#7f8da2;font-size:9px;font-weight:800}
    .bottom-nav a span:first-child{font-size:16px;line-height:1}
    .bottom-nav a.active{color:var(--gold-2)}

    .toast{
      position:fixed;z-index:100;left:16px;right:16px;bottom:82px;
      padding:13px 14px;border:1px solid var(--line);border-radius:14px;background:#0e1d33;
      box-shadow:0 16px 40px rgba(0,0,0,.35);font-size:12px;display:none
    }
    .toast.show{display:block;animation:toast-in .2s ease}
    @keyframes toast-in{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}.toast{animation:none}}

    @media(min-width:700px){
      .container{width:min(calc(100% - 48px),var(--max))}
      .hero{padding:110px 0 72px}
      .hero-actions{flex-direction:row}
      .hero-actions .btn{min-width:180px}
      .hero-strip{grid-template-columns:repeat(4,1fr);padding:20px}
      section{padding:86px 0}
      .grid-3{grid-template-columns:repeat(3,1fr)}
      .grid-2{grid-template-columns:repeat(2,1fr)}
      .people{grid-template-columns:repeat(4,1fr)}
      .dash-grid{grid-template-columns:repeat(3,1fr)}
      .footer-grid{grid-template-columns:2fr 1fr 1fr}
      .bottom-nav{display:none}
      .mobile-menu,.menu-btn{display:none!important}
      .desktop-nav{display:flex;gap:24px;align-items:center}
      .desktop-nav a{font-size:12px;color:#b4bfd0}
      .desktop-nav a:hover{color:var(--gold-2)}
      .login-btn{padding:0 16px}
    }
  </style>
</head>

<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#home" aria-label="EESA home">
      <div class="brand-mark">E</div>
      <div>
        <div class="brand-name">EESA <span style="color:var(--gold-2)">| DYPSEM</span></div>
        <span class="brand-sub">Electrical Engineering Students Association</span>
      </div>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#committee">Committee</a>
      <a href="#events">Events</a>
      <a href="#projects">Projects</a>
    </nav>

    <div class="header-actions">
      <a class="login-btn" href="#portal">Login</a>
      <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false">☰</button>
    </div>
  </div>
</header>

<nav class="mobile-menu" id="mobileMenu" aria-label="Mobile navigation">
  <a href="#home">Home</a>
  <a href="#about">About EESA</a>
  <a href="#committee">Committee</a>
  <a href="#events">Events</a>
  <a href="#projects">Projects</a>
  <a href="#portal">Student Portal</a>
</nav>

<main>
  <section class="hero" id="home">
    <div class="container">
      <div class="eyebrow"><span class="eyebrow-dot"></span> Electrical Engineering • DYPSEM</div>
      <h1>Where Electrical Engineering <span class="gradient-text">comes alive.</span></h1>
      <p class="hero-copy">
        The official digital home of EESA — discover the committee, events, projects, opportunities and the student community behind Electrical Engineering at D.Y. Patil School of Engineering & Management.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#events">Explore Events</a>
        <a class="btn btn-secondary" href="#committee">Meet EESA</a>
      </div>

      <div class="hero-strip" aria-label="EESA highlights">
        <div class="stat"><strong>Events</strong><span>Workshops & fests</span></div>
        <div class="stat"><strong>Projects</strong><span>Build together</span></div>
        <div class="stat"><strong>Community</strong><span>Students & seniors</span></div>
        <div class="stat"><strong>Portal</strong><span>Members only</span></div>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">About EESA</div>
        <h2 class="section-title">More than an association.</h2>
        <p class="section-copy">EESA connects students with technical activities, events, projects and the people who make the department's student community active.</p>
      </div>

      <div class="grid grid-3">
        <article class="card">
          <h3>Learn beyond the classroom</h3>
          <p>Workshops, technical activities, competitions and practical experiences complement your academic journey.</p>
          <span class="tag">Learn</span>
        </article>
        <article class="card">
          <h3>Build with other students</h3>
          <p>Discover projects, find teammates and connect with seniors who are already building things.</p>
          <span class="tag">Build</span>
        </article>
        <article class="card">
          <h3>Be part of EESA</h3>
          <p>Participate in events, contribute to the association and help shape what happens in the department.</p>
          <span class="tag">Participate</span>
        </article>
      </div>
    </div>
  </section>

  <section id="committee">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">The people behind EESA</div>
        <h2 class="section-title">Meet the committee.</h2>
        <p class="section-copy">The public site will introduce the current committee clearly. Detailed member tools stay inside the authenticated portal.</p>
      </div>

      <div class="grid people">
        <article class="card person"><div class="avatar">P</div><strong>President</strong><span>Committee</span></article>
        <article class="card person"><div class="avatar">S</div><strong>Secretary</strong><span>Committee</span></article>
        <article class="card person"><div class="avatar">T</div><strong>Technical Head</strong><span>Technical Team</span></article>
        <article class="card person"><div class="avatar">E</div><strong>Event Head</strong><span>Events Team</span></article>
      </div>
    </div>
  </section>

  <section id="events">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">What's happening</div>
        <h2 class="section-title">Upcoming events.</h2>
        <p class="section-copy">Event information can remain publicly discoverable. Registration, attendance and member-only actions can require login.</p>
      </div>

      <div class="grid grid-2">
        <article class="card event-card">
          <div class="event-top">
            <div>
              <div class="event-date">Coming soon</div>
              <h3 style="margin-top:5px">Technologia</h3>
            </div>
            <span class="event-status">Upcoming</span>
          </div>
          <p>Technical activities, competitions and student participation organised around the department's technical community.</p>
          <div class="event-footer"><span>DYPSEM Campus</span><a class="btn btn-secondary" style="min-height:38px;padding:0 12px;font-size:11px" href="#portal">Details</a></div>
        </article>

        <article class="card event-card">
          <div class="event-top">
            <div>
              <div class="event-date">Event mode</div>
              <h3 style="margin-top:5px">Live Quiz</h3>
            </div>
            <span class="event-status">Event-only</span>
          </div>
          <p>The quiz system is intentionally not part of the normal website flow. It appears when EESA runs a quiz-enabled event.</p>
          <div class="event-footer"><span>Members / participants</span><span>Inactive</span></div>
        </article>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Student ecosystem</div>
        <h2 class="section-title">Projects worth discovering.</h2>
        <p class="section-copy">A future project board will let seniors share projects and invite juniors to collaborate without turning EESA into an academic file repository.</p>
      </div>

      <div class="grid grid-3">
        <article class="card"><h3>Project showcase</h3><p>See what EESA students are building and what technologies they are using.</p></article>
        <article class="card"><h3>Join a team</h3><p>Logged-in students can express interest in projects with open roles.</p></article>
        <article class="card"><h3>Build together</h3><p>Project creators can manage applicants and keep collaboration inside the portal.</p></article>
      </div>
    </div>
  </section>

  <section class="portal-wrap" id="portal">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Student portal</div>
        <h2 class="section-title">Your EESA space.</h2>
        <p class="section-copy">Public visitors can explore EESA freely. Login unlocks student and committee features.</p>
      </div>

      <div class="card auth-card">
        <div id="loginView" class="login-view">
          <h3 style="font-size:18px;margin-bottom:5px">Sign in to EESA</h3>
          <p style="font-size:12px;color:var(--muted);margin:0 0 18px">New accounts automatically start with the Student role.</p>

          <form id="authForm">
            <div class="field">
              <label for="email">College / registered email</label>
              <input id="email" type="email" autocomplete="email" required placeholder="you@example.com">
            </div>
            <div class="field">
              <label for="password">Password</label>
              <input id="password" type="password" autocomplete="current-password" required minlength="6" placeholder="••••••••">
            </div>
            <div class="auth-actions">
              <button class="btn btn-primary" type="submit" data-action="login">Sign in</button>
              <button class="btn btn-secondary" type="button" id="signupBtn">Create account</button>
            </div>
            <div class="status" id="authStatus" role="status"></div>
          </form>
        </div>

        <div id="dashboard" class="dashboard">
          <div class="dash-top">
            <div>
              <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em">Signed in as</div>
              <div class="dash-email" id="dashEmail">student</div>
            </div>
            <span class="role" id="dashRole">Student</span>
          </div>
          <div class="dash-grid">
            <div class="dash-item"><strong>Events</strong><p>Your registrations and upcoming EESA events.</p></div>
            <div class="dash-item"><strong>Projects</strong><p>Discover projects and collaboration opportunities.</p></div>
            <div class="dash-item"><strong>Notices</strong><p>Member notices and important updates.</p></div>
          </div>
          <button class="btn btn-secondary" id="logoutBtn" style="width:100%;margin-top:12px">Sign out</button>
        </div>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="container footer-grid">
    <div>
      <h3>EESA • DYPSEM</h3>
      <p>Electrical Engineering Students Association<br>D.Y. Patil School of Engineering & Management, Kolhapur, Maharashtra.</p>
    </div>
    <div>
      <h3>Institution</h3>
      <p><a href="https://dypatilunikop.org/school-of-engineering-management-kolhapur/" target="_blank" rel="noopener">DYPSEM</a><br><a href="https://sem.dypatilunikop.org/" target="_blank" rel="noopener">Admissions</a></p>
    </div>
    <div>
      <h3>Contact</h3>
      <p>eesa.dypsem@dypatilunikop.org</p>
    </div>
  </div>
</footer>

<nav class="bottom-nav" aria-label="Quick navigation">
  <a class="active" href="#home"><span>⌂</span><span>Home</span></a>
  <a href="#events"><span>◷</span><span>Events</span></a>
  <a href="#projects"><span>◇</span><span>Projects</span></a>
  <a href="#portal"><span>○</span><span>Portal</span></a>
</nav>

<div class="toast" id="toast" role="status"></div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
  import {
    getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword,
    onAuthStateChanged, signOut
  } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
  import {
    getFirestore, doc, getDoc, setDoc, serverTimestamp
  } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyAA0Z3wxVTZfnycymlMnLg2DBfWiEV7LhM",
    authDomain: "eesa-association-dypsem.firebaseapp.com",
    projectId: "eesa-association-dypsem",
    storageBucket: "eesa-association-dypsem.firebasestorage.app",
    messagingSenderId: "904621731688",
    appId: "1:904621731688:web:e72541588ac301002d30dd"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const loginView = document.getElementById("loginView");
  const dashboard = document.getElementById("dashboard");
  const dashEmail = document.getElementById("dashEmail");
  const dashRole = document.getElementById("dashRole");
  const authStatus = document.getElementById("authStatus");
  const toast = document.getElementById("toast");

  function showToast(message){
    toast.textContent = message;
    toast.classList.add("show");
    clearTimeout(showToast.timer);
    showToast.timer = setTimeout(() => toast.classList.remove("show"), 2800);
  }

  function setStatus(message, error=false){
    authStatus.textContent = message;
    authStatus.style.color = error ? "var(--danger)" : "var(--muted)";
  }

  function friendlyAuthError(error){
    const code = error?.code || "";
    const map = {
      "auth/invalid-credential":"Email or password is incorrect.",
      "auth/invalid-email":"Please enter a valid email address.",
      "auth/email-already-in-use":"An account already exists for this email.",
      "auth/weak-password":"Use a stronger password (at least 6 characters).",
      "auth/network-request-failed":"Network problem. Please try again."
    };
    return map[code] || "Authentication failed. Please try again.";
  }

  /*
    Role model:
    - Every new user is created as "student".
    - Committee roles will later be derived from a central committee document.
    - UI role checks are NOT a security boundary. Firestore rules / trusted
      server-side logic must enforce privileged operations.
  */
  async function getEffectiveRole(uid){
    let userData = {};
    const userSnap = await getDoc(doc(db, "users", uid));

    if(userSnap.exists()) userData = userSnap.data();

    // Existing explicit admin/superAdmin roles remain supported.
    if(userData.role === "admin" || userData.role === "superAdmin") return userData.role;

    // Future committee document: committee/current
    const committeeSnap = await getDoc(doc(db, "committee", "current"));
    if(committeeSnap.exists()){
      const committee = committeeSnap.data();
      const positions = committee.positions || {};
      for(const [position, memberUid] of Object.entries(positions)){
        if(memberUid === uid) return position;
      }
    }

    return "student";
  }

  onAuthStateChanged(auth, async (user) => {
    if(!user){
      loginView.classList.remove("hidden");
      dashboard.classList.remove("active");
      return;
    }

    loginView.classList.add("hidden");
    dashboard.classList.add("active");
    dashEmail.textContent = user.email || "EESA member";

    try{
      const role = await getEffectiveRole(user.uid);
      dashRole.textContent = role.replaceAll("_"," ");
    }catch(error){
      dashRole.textContent = "student";
    }
  });

  document.getElementById("authForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = document.getElementById("email").value.trim();
    const password = document.getElementById("password").value;

    setStatus("Signing in…");
    try{
      await signInWithEmailAndPassword(auth, email, password);
      setStatus("");
      showToast("Welcome back to EESA.");
      location.hash = "#portal";
    }catch(error){
      setStatus(friendlyAuthError(error), true);
    }
  });

  document.getElementById("signupBtn").addEventListener("click", async () => {
    const email = document.getElementById("email").value.trim();
    const password = document.getElementById("password").value;

    if(!email || password.length < 6){
      setStatus("Enter an email and a password of at least 6 characters.", true);
      return;
    }

    setStatus("Creating your account…");
    try{
      const cred = await createUserWithEmailAndPassword(auth, email, password);

      await setDoc(doc(db, "users", cred.user.uid), {
        email,
        role: "student",
        createdAt: serverTimestamp()
      }, { merge:true });

      setStatus("");
      showToast("Account created. You are now a Student member.");
    }catch(error){
      setStatus(friendlyAuthError(error), true);
    }
  });

  document.getElementById("logoutBtn").addEventListener("click", async () => {
    await signOut(auth);
    showToast("Signed out.");
  });
</script>

<script>
  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");

  menuBtn?.addEventListener("click", () => {
    const open = mobileMenu.classList.toggle("open");
    menuBtn.setAttribute("aria-expanded", String(open));
  });

  mobileMenu?.querySelectorAll("a").forEach(a => {
    a.addEventListener("click", () => {
      mobileMenu.classList.remove("open");
      menuBtn.setAttribute("aria-expanded","false");
    });
  });

  const navLinks = document.querySelectorAll(".bottom-nav a");
  const sections = ["home","events","projects","portal"].map(id => document.getElementById(id)).filter(Boolean);

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        navLinks.forEach(link => link.classList.toggle("active", link.getAttribute("href") === "#" + entry.target.id));
      }
    });
  }, {rootMargin:"-35% 0px -55% 0px", threshold:0});

  sections.forEach(section => observer.observe(section));
</script>
</body>
</html>
